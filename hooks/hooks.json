{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "agentboard codex-hook --activate",
            "commandWindows": "agentboard codex-hook --activate",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "agentboard codex-hook",
            "commandWindows": "agentboard codex-hook",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
